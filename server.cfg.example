# txAdmin QBCore / G-Portal server config template
# Copy this file to server.cfg locally, then replace CHANGE_ME values.
# Do not commit real license keys, DB passwords, RCON passwords, or Tebex secrets.

endpoint_add_tcp "0.0.0.0:30120"
endpoint_add_udp "0.0.0.0:30120"
sv_maxclients 20

set steam_webApiKey "none"
set resources_useSystemChat true
set mysql_connection_string "mysql://CHANGE_ME:CHANGE_ME@CHANGE_ME:3306/CHANGE_ME"
set mysql_ui true

## txAdmin manages OneSync from the txAdmin settings page.
# set onesync on

sets tags "default, deployer, qbcore, qb-core"
sets sv_projectName "[QBCore Framework] SentinelRP"
sets sv_projectDesc "An advanced FiveM RP framework including jobs, gangs, housing & more!"
sets locale "root-AQ"

sv_licenseKey "CHANGE_ME"
sv_hostname "Sentinel RP"
load_server_icon myLogo.png
sv_enforceGameBuild 3095

setr voice_useNativeAudio true
setr voice_useSendingRangeOnly true
setr voice_defaultCycle "GRAVE"
setr voice_defaultVolume 0.3
setr voice_enableRadioAnim 1
setr voice_syncData 1
setr qb_locale "en"
setr UseTarget false

ensure oxmysql
ensure mapmanager
ensure chat
ensure spawnmanager
ensure sessionmanager
ensure basic-gamemode
ensure hardcap
ensure baseevents
ensure qb-core
ensure fivem_vmenu
ensure fivem_els
ensure [qb]
ensure [standalone]
ensure [voice]
ensure [defaultmaps]

add_ace group.admin command allow
add_ace group.admin srp_medical.admin allow
add_ace resource.qb-core command allow
add_ace qbcore.god command allow
add_principal qbcore.god group.admin
add_principal qbcore.god qbcore.admin
add_principal qbcore.admin qbcore.mod

rcon_password "CHANGE_ME"
sv_scriptHookAllowed 0
sv_tebexSecret ""
